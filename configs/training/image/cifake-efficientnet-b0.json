{
  "dataset_name": "CIFAKE",
  "dataset_version": "3",
  "task": "ai_generated_image",
  "dataset_root": "datasets/raw/images/CIFAKE-v3",
  "train_manifest": "datasets/manifests/CIFAKE-v3-leakage-final_train.jsonl",
  "validation_manifest": "datasets/manifests/CIFAKE-v3-leakage-final_validation.jsonl",
  "test_manifest": "datasets/manifests/CIFAKE-v3-leakage-final_test.jsonl",
  "architecture": "efficientnet-b0",
  "num_classes": 2,
  "labels": {"REAL": 0, "FAKE": 1},
  "image_size": [32, 32],
  "seed": 42,
  "deterministic": true,
  "device": "auto",
  "batch_size": 128,
  "num_workers": 2,
  "max_epochs": 30,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "scheduler": "cosine_annealing",
  "early_stopping_patience": 5,
  "early_stopping_min_delta": 0.0005,
  "mixed_precision": false,
  "gradient_clip_norm": 1.0,
  "horizontal_flip_probability": 0.5,
  "crop_padding": 2,
  "evaluation_threshold": 0.5
}
